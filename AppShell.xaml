<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KuenTly.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inicio="clr-namespace:KuenTly.Views.Inicio"
    xmlns:clientes="clr-namespace:KuenTly.Views.Clientes"
    xmlns:recordatorios="clr-namespace:KuenTly.Views.Recordatorios"
    Title="KuenTly">

    <TabBar>
        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate inicio:InicioPage}"
            Route="Inicio" />

        <ShellContent
            Title="Clientes"
            ContentTemplate="{DataTemplate clientes:ClientesPage}"
            Route="Clientes" />

        <ShellContent
            Title="Recordatorios"
            ContentTemplate="{DataTemplate recordatorios:RecordatoriosPage}"
            Route="Recordatorios" />
    </TabBar>

</Shell>