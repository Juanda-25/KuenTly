<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KuenTly.ViewModels.Ventas"
             xmlns:models="clr-namespace:KuenTly.Models"
             x:Class="KuenTly.Views.Ventas.VentaDetallePage"
             x:DataType="vm:VentaDetalleViewModel"
             x:Name="PageRoot"
             Title="Detalle de la venta">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar" Command="{Binding EditarCommand}" />
        <ToolbarItem Text="Eliminar" Command="{Binding EliminarCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="{Binding Resumen.Venta.Descripcion}" Style="{StaticResource Titulo}" FontSize="18" />
            <Label Text="{Binding Resumen.Venta.FechaVenta, StringFormat='Venta: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
            <Label Text="{Binding Resumen.Venta.FechaPagoAcordada, StringFormat='Pago acordado: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Grid.Column="0" Text="{Binding Resumen.Saldo, StringFormat='Saldo: $ {0:N0}'}" Style="{StaticResource MontoDestacado}" FontSize="22" />
                <Label Grid.Column="1" Text="{Binding Resumen.Estado, Converter={StaticResource EstadoTextoConverter}}"
                       TextColor="{Binding Resumen.Estado, Converter={StaticResource EstadoColorConverter}}"
                       FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,8">
            <Label Grid.Column="0" Text="Historial de abonos" Style="{StaticResource Titulo}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="+ Nuevo abono" Command="{Binding NuevoAbonoCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Turquesa}" FontSize="13" Padding="4" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Abonos}">
            <CollectionView.EmptyView>
                <Label Text="Esta venta todavía no tiene abonos registrados"
                       Style="{StaticResource Caption}"
                       Margin="0,10,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Abono">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Anular"
                                           BackgroundColor="{StaticResource EstadoMora}"
                                           Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AnularAbonoCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 8" Margin="0,4" Padding="12">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding MetodoPago}" Style="{StaticResource Titulo}" FontSize="15" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Valor, StringFormat='$ {0:N0}'}" Style="{StaticResource Titulo}" FontSize="15" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding FechaAnulacion, StringFormat='Anulado el {0:dd/MM/yyyy}'}"
                                       TextColor="{StaticResource EstadoMora}" FontSize="12"
                                       IsVisible="{Binding Anulado}" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding MotivoAnulacion, StringFormat='Motivo: {0}'}"
                                       Style="{StaticResource Caption}"
                                       FontAttributes="Italic"
                                       IsVisible="{Binding Anulado}"
                                       Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>