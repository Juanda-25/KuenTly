<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KuenTly.ViewModels.Recordatorios"
             xmlns:models="clr-namespace:KuenTly.Models"
             x:Class="KuenTly.Views.Recordatorios.RecordatoriosPage"
             x:DataType="vm:RecordatoriosViewModel"
             x:Name="PageRoot"
             Title="Recordatorios">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding NuevoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,8">
            <Label Text="Mostrar completados" VerticalOptions="Center" Style="{StaticResource Caption}" />
            <Switch IsToggled="{Binding MostrarCompletados}" />
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding CargarCommand}">
            <CollectionView ItemsSource="{Binding Recordatorios}"
                            SelectionMode="Single"
                            SelectedItem="{Binding RecordatorioSeleccionado}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Padding="0,60,0,0">
                        <Label Text="No tienes recordatorios pendientes"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recordatorio">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="{Binding Completado, Converter={StaticResource CompletadoAccionConverter}}"
                                               BackgroundColor="{StaticResource EstadoAlDia}"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleCompletadoCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 8" Margin="0,4" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Cliente.Nombre}" Style="{StaticResource Titulo}" FontSize="15" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Mensaje}" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="✓ Completado" TextColor="{StaticResource EstadoAlDia}" FontSize="12"
                                           IsVisible="{Binding Completado}" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>