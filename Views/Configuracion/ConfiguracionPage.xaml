<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KuenTly.ViewModels.Configuracion"
             x:Class="KuenTly.Views.Configuracion.ConfiguracionPage"
             x:DataType="vm:ConfiguracionViewModel"
             Title="Configuración">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Copias de seguridad" Style="{StaticResource Titulo}" FontSize="18" />
        <Label Text="Crea una copia de todos tus datos y guárdala donde quieras (Drive, WhatsApp, tu computador). También puedes restaurar una copia anterior."
               Style="{StaticResource Caption}" />

        <Button Text="Crear copia de seguridad" Command="{Binding CrearBackupCommand}" Margin="0,10,0,0" />
        <Button Text="Restaurar copia de seguridad" Command="{Binding RestaurarBackupCommand}"
                BackgroundColor="Transparent" TextColor="{StaticResource EstadoMora}" />

        <Label Text="{Binding MensajeExito}"
               TextColor="{StaticResource EstadoAlDia}"
               IsVisible="{Binding MensajeExito, Converter={StaticResource StringNotEmptyConverter}}" />

        <Label Text="{Binding MensajeError}"
               TextColor="{StaticResource EstadoMora}"
               IsVisible="{Binding MensajeError, Converter={StaticResource StringNotEmptyConverter}}" />

    </VerticalStackLayout>

</ContentPage>